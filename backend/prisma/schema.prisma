// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  phoneNumber        String?
  profileImage       String?
  isTwoFactorEnabled Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  reason    String // 'RESET_PASSWORD', '2FA'
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  staff           Staff[]
}

model RolePermission {
  roleId       Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Shift {
  id           Int          @id @default(autoincrement())
  name         String
  departmentId Int?
  department   Department?  @relation(fields: [departmentId], references: [id])
  slots        ShiftSlot[]
  staffShifts  StaffShift[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model ShiftSlot {
  id             Int      @id @default(autoincrement())
  shiftId        Int
  shift          Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  startDayOfWeek String   // Monday, Tuesday, etc.
  endDayOfWeek   String   // Monday, Tuesday, etc.
  startTime      String   // "08:00"
  endTime        String   // "16:00"
  duration       Int      // in minutes
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StaffShift {
  id        Int      @id @default(autoincrement())
  staffId   Int
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  shiftId   Int
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Staff {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  phoneNumber   String?
  profileImage  String?
  roleId        Int
  role               Role           @relation(fields: [roleId], references: [id])
  departmentId       Int?
  department         Department?    @relation(fields: [departmentId], references: [id])
  isActive           Boolean        @default(true)
  isTwoFactorEnabled Boolean        @default(false)
  consultationFee    Float          @default(0)
  consultationDuration Int        @default(15)
  biometricPin       String?        @unique
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  staffShifts        StaffShift[]
  appointments       Appointment[]
  labTests           LabTest[]
  prescriptions      Prescription[]
  transactions       Transaction[]
  salary             StaffSalary?
  attendanceRecords  AttendanceRecord[]
  attendanceSummaries DailyAttendanceSummary[]

  createdPatients    Patient[] @relation("PatientCreator")
  createdAppointments Appointment[] @relation("AppointmentCreator")
  createdLabTests    LabTest[] @relation("LabTestCreator")
}

model Service {
  id               Int      @id @default(autoincrement())
  name             String
  category         String?
  specialty        String?
  description      String?
  shortDescription String?
  image            String?
  imageAlt         String?
  icon             String?
  baseCost         Float?
  successRate      Float?
  rating           Float?
  patientsServed   Int?
  features         String[] @default([])
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("services")
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  staff       Staff[]
  shifts      Shift[]
}

model Patient {
  id          Int      @id @default(autoincrement())
  mrNumber    String   @unique
  name        String
  email       String? // Optional, not unique as minors might share parent email
  phoneNumber String?
  cnic        String?
  age         Int?
  gender      String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments  Appointment[]
  labTests      LabTest[]
  prescriptions Prescription[]
  bedAssignments BedAssignment[]
  transactions  Transaction[]
  assetRents    HospitalAssetRent[]

  createdById   Int?
  createdBy     Staff?   @relation("PatientCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([createdAt])
}

model Appointment {
  id     Int      @id @default(autoincrement())
  date   DateTime
  time   String
  reason String?
  status String   @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id])

  doctorId Int
  doctor   Staff @relation(fields: [doctorId], references: [id])

  prescription Prescription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transaction Transaction?
  queueToken QueueToken?

  createdById Int?
  createdBy   Staff? @relation("AppointmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([createdAt])
  @@index([doctorId])
}

model Prescription {
  id                  Int       @id @default(autoincrement())
  date                DateTime  @default(now())
  diagnosis           String?   @db.Text
  prescriptionContent String?   @db.Text
  nextFollowUp        DateTime?

  appointmentId Int         @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id])

  doctorId Int
  doctor   Staff @relation(fields: [doctorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Test {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  category  String?
  price     Float     @default(0)
  isActive  Boolean   @default(true)
  labTests  LabTest[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model LabTest {
  id           Int       @id @default(autoincrement())
  testId       Int?
  test         Test?     @relation(fields: [testId], references: [id])
  testName     String
  fillerOrderNumber String? @unique
  result       String?
  reportFile   String? // Link to uploaded PDF/image
  expectedDate DateTime? // Date when the report is expected
  status       String    @default("PENDING") // PENDING, ACCEPTED, COMPLETED

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id])

  conductedById Int?
  conductedBy   Staff? @relation(fields: [conductedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transaction Transaction?
  queueToken  QueueToken?

  createdById Int?
  createdBy   Staff? @relation("LabTestCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([createdAt])
}

enum TransactionType {
  INCOME
  EXPENSE
}

model TransactionCategory {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  description  String?
  type         TransactionType // Whether this category is typically for INCOME or EXPENSE
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Transaction {
  id              Int                 @id @default(autoincrement())
  type            TransactionType
  categoryId      Int
  category        TransactionCategory @relation(fields: [categoryId], references: [id])
  amount          Float
  baseAmount      Float               @default(0)
  discount        Float               @default(0)
  method          String              // CASH, CARD, ONLINE, BANK_TRANSFER
  status          String              @default("PAID") // PENDING, PAID, CANCELLED
  
  patientId       Int?
  patient         Patient?            @relation(fields: [patientId], references: [id])
  
  staffId         Int?                // For Salaries or staff-related expenses
  staff           Staff?              @relation(fields: [staffId], references: [id])
  
  appointmentId   Int?                @unique
  appointment     Appointment?        @relation(fields: [appointmentId], references: [id])
  
  labTestId       Int?                @unique
  labTest         LabTest?            @relation(fields: [labTestId], references: [id])
  
  bedAssignmentId Int?                @unique
  bedAssignment   BedAssignment?      @relation(fields: [bedAssignmentId], references: [id])
  
  assetRentId     Int?                @unique
  assetRent       HospitalAssetRent?  @relation(fields: [assetRentId], references: [id])

  referenceNumber String?             @unique // Invoice # or Receipt #
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([type])
  @@index([categoryId])
  @@index([createdAt])
  @@index([status])
}

model StaffSalary {
  id           Int      @id @default(autoincrement())
  staffId      Int      @unique
  staff        Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  baseSalary   Float    @default(0)
  allowances   Float    @default(0)
  deductions   Float    @default(0)
  netSalary    Float    @default(0)
  payDate      Int?     @default(1) // Day of month (e.g., 1st, 5th)
  updatedAt    DateTime @updatedAt
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  CLEANING
  RESERVED
}

model Ward {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique // e.g., "ICU-01"
  description String?
  isActive    Boolean  @default(true)
  rooms       Room[]
  beds        Bed[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RoomCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  pricePerDay Float
  description String?
  rooms       Room[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HospitalAssetRent {
  id              Int          @id @default(autoincrement())
  patientId       Int
  patient         Patient      @relation(fields: [patientId], references: [id])
  assetType       String       // e.g., "BED", "EQUIPMENT"
  assetId         Int?         // Optional ID of the specific asset
  startDate       DateTime     @default(now())
  endDate         DateTime?
  ratePerDay      Float
  totalAmount     Float?
  status          String       @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  transaction     Transaction?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}


model Room {
  id         Int      @id @default(autoincrement())
  wardId     Int
  ward       Ward     @relation(fields: [wardId], references: [id], onDelete: Cascade)
  roomNumber String
  floor      Int?
  isActive   Boolean  @default(true)
  categoryId Int?
  category   RoomCategory? @relation(fields: [categoryId], references: [id])
  beds       Bed[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Bed {
  id          Int             @id @default(autoincrement())
  roomId      Int?
  wardId      Int
  room        Room?           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  ward        Ward            @relation(fields: [wardId], references: [id], onDelete: Cascade)
  bedNumber   String
  status      BedStatus       @default(AVAILABLE)
  isActive    Boolean         @default(true)
  assignments BedAssignment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
  @@index([wardId, status])
}

model BedAssignment {
  id                  Int       @id @default(autoincrement())
  patientId           Int
  bedId               Int
  patient             Patient   @relation(fields: [patientId], references: [id])
  bed                 Bed       @relation(fields: [bedId], references: [id], onDelete: Cascade)
  assignedAt          DateTime  @default(now())
  assignedBy          Int // admin/staff ID
  expectedDischargeAt DateTime?
  actualDischargeAt   DateTime?
  dischargeReason     String? // e.g., "RECOVERED", "TRANSFERRED", "DECEASED"
  dischargedBy        Int?
  notes               String?

  // For patient transfer tracking
  transferredFromId Int?
  transferredToId   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  transaction Transaction?
  
  dailyRate Float?    @default(0)
  totalBill Float?    @default(0)
  isPaid    Boolean   @default(false)

  @@index([patientId])
  @@index([bedId])
  @@index([actualDischargeAt])
}

model QueueToken {
  id             Int          @id @default(autoincrement())
  tokenNumber    Int
  department     String       @default("RECEPTION") // e.g. "DOCTOR", "LAB", "PHARMACY"
  status         String       @default("WAITING") // WAITING, SERVING, SKIPPED, COMPLETED
  date           DateTime     @default(now())
  
  appointmentId  Int?         @unique
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  
  labTestId      Int?         @unique
  labTest        LabTest?     @relation(fields: [labTestId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([date, department])
}


model BiometricDevice {
  id           Int                @id @default(autoincrement())
  name         String
  ipAddress    String             @unique
  port         Int                @default(4370)
  status       String             @default("UNKNOWN") // CONNECTED, DISCONNECTED, UNKNOWN
  lastSyncAt   DateTime?
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  records      AttendanceRecord[]
}

model AttendanceRecord {
  id                 Int              @id @default(autoincrement())
  deviceUserPin      String
  staffId            Int?
  staff              Staff?           @relation(fields: [staffId], references: [id], onDelete: Cascade)
  timestamp          DateTime
  status             String           @default("UNKNOWN") // CHECK_IN, CHECK_OUT, BREAK_IN, BREAK_OUT, UNKNOWN
  verifyMode         Int              @default(0)
  deviceUid          String           @unique // unique identifier to prevent duplicate syncing
  biometricDeviceId  Int?
  biometricDevice    BiometricDevice? @relation(fields: [biometricDeviceId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())

  @@index([staffId])
  @@index([timestamp])
  @@index([deviceUserPin])
  @@index([deviceUid])
}

model DailyAttendanceSummary {
  id               Int       @id @default(autoincrement())
  staffId          Int
  staff            Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date             DateTime  // YYYY-MM-DD (date component only)
  checkIn          DateTime?
  checkOut         DateTime?
  totalHours       Float     @default(0)
  status           String    @default("ABSENT") // PRESENT, LATE, EARLY_DEPARTURE, ABSENT, ON_LEAVE, HALFDAY, OFF_DAY
  overtimeMinutes  Int       @default(0)
  lateMinutes      Int       @default(0)
  isManualOverride Boolean   @default(false)
  overrideNotes    String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([staffId, date])
  @@index([staffId])
  @@index([date])
  @@index([status])
}

model Hl7Log {
  id          Int      @id @default(autoincrement())
  messageId   String?  // Message Control ID from MSH-10
  type        String   // ADT^A01, ORM^O01, ORU^R01, etc.
  direction   String   // INBOUND or OUTBOUND
  rawMessage  String   @db.Text
  status      String   @default("PROCESSED") // PROCESSED, ERROR, PENDING
  errorDetails String? @db.Text
  createdAt   DateTime @default(now())
  
  @@index([type])
  @@index([direction])
  @@index([createdAt])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String   @default("General Inquiry")
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([isRead])
}

